{
  "manifest_version": 3,
  "name": "Multi Find",
  "version": "1.3.0",
  "description": "Automatically search and highlight multiple keywords on every page after keywords are set.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Multi Find"
  }
}